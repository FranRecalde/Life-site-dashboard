# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# OAuth callback trust is not derived from APP_URL. Deployed Google OAuth uses
# only the exact approved incoming production or staging service hostname.
APP_URL="MY_APP_URL"

# Username and Password Hash for Life Site Dashboard Authentication
# CRITICAL COMPLIANCE RULES:
# - "admin" is rejected in production.
# - Plaintext passwords are rejected in production.
# - The username should be Francisco only if that is the intended exact login username.
# - The password hash must contain exactly four sections separated by '$': pbkdf2_sha256$iterations$salt$hash
# - The final hash section must be exactly 64 hexadecimal characters.
LIFE_SITE_USERNAME="your_non_default_username"
LIFE_SITE_PASSWORD_HASH="pbkdf2_sha256$ITERATIONS$SALT$64_CHARACTER_HEX_HASH"

# SESSION_SECRET: A long, random cryptographic session-signing key of your choice.
# This is NOT a Google Client Secret.
SESSION_SECRET="generate_a_long_random_value"

# Dedicated Reading Capture API credential hash (SHA-256, 64 hexadecimal characters).
# Configure only the hash. Never place the raw bearer token in this file.
READING_CAPTURE_API_TOKEN_HASH=""

# Todoist REST API Token (Optional, can be entered in Settings too)
TODOIST_API_TOKEN=""

# Google Calendar OAuth Client Credentials (Can be entered in Settings too)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Local development: npm run dev supplies STORAGE_PROVIDER=local explicitly.
# Local JSON storage is suitable only for local development and automated tests;
# it is not durable on Cloud Run and does not require a cloud database.
NODE_ENV="development"
STORAGE_PROVIDER="local"

# Local development may deliberately use environment values and data/secrets.json.
# Deployed production and staging reject this provider and require secretmanager.
SECRET_PROVIDER="existing"
SECRET_MANAGER_PROJECT_ID=""
SECRET_NAME_PREFIX=""

# Staging and production must instead set every value below explicitly:
# NODE_ENV="production"
# STORAGE_PROVIDER="firestore"
# GOOGLE_CLOUD_PROJECT="your-explicit-project-id"
# FIRESTORE_DATABASE_ID="your-explicit-database-id"
# SECRET_PROVIDER="secretmanager"
# SECRET_MANAGER_PROJECT_ID="gen-lang-client-0802447346"
# SECRET_NAME_PREFIX="life-site-prod-or-life-site-staging"
# Use FIRESTORE_DATABASE_ID="(default)" only when that exact database is intended.
# Missing or invalid STORAGE_PROVIDER values are startup errors. The dual provider
# is temporary local migration tooling and must never be used for normal staging
# or production operation.
#
# Required deployed secret configuration:
# Production: SECRET_NAME_PREFIX="life-site-prod"
# Staging:    SECRET_NAME_PREFIX="life-site-staging"
# Both:       SECRET_MANAGER_PROJECT_ID="gen-lang-client-0802447346"
# GOOGLE_CLOUD_PROJECT identifies Firestore data only. It never selects the
# Secret Manager project.

# Required when STORAGE_PROVIDER is firestore or dual. The application does not
# discover the project from ADC and does not accept FIRESTORE_PROJECT_ID.
GOOGLE_CLOUD_PROJECT=""

# Required when STORAGE_PROVIDER is firestore or dual. No database default is
# inferred when this variable is missing.
FIRESTORE_DATABASE_ID=""
