# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Username and Password Hash for Life Site Dashboard Authentication
# CRITICAL COMPLIANCE RULES:
# - "admin" is rejected in production.
# - Plaintext passwords are rejected in production.
# - The username should be Francisco only if that is the intended exact login username.
# - The password hash must contain exactly four sections separated by '$': pbkdf2_sha256$iterations$salt$hash
# - The final hash section must be exactly 64 hexadecimal characters.
LIFE_SITE_USERNAME="your_non_default_username"
LIFE_SITE_PASSWORD_HASH="pbkdf2_sha256$ITERATIONS$SALT$64_CHARACTER_HEX_HASH"

# SESSION_SECRET: A long, random cryptographic session-signing key of your choice.
# This is NOT a Google Client Secret.
SESSION_SECRET="generate_a_long_random_value"

# Todoist REST API Token (Optional, can be entered in Settings too)
TODOIST_API_TOKEN=""

# Google Calendar OAuth Client Credentials (Can be entered in Settings too)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# STORAGE_PROVIDER: Determines data persistence mode.
# Values: 'local' (JSON file), 'dual' (read Firestore, fallback to local file, write to both), 'firestore' (read/write only Firestore).
STORAGE_PROVIDER="local"

# SECRET_PROVIDER: Determines secret management provider.
# Values: 'existing' (local file/env), 'secretmanager' (Google Cloud Secret Manager).
SECRET_PROVIDER="existing"

# GOOGLE_CLOUD_PROJECT: The ID of your Google Cloud Platform project used for Firestore.
GOOGLE_CLOUD_PROJECT=""

# FIRESTORE_DATABASE_ID: Optional database ID if using a non-default Firestore database instance.
FIRESTORE_DATABASE_ID=""
