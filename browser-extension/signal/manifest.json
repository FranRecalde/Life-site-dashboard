{
  "manifest_version": 3,
  "name": "Life Site Signal",
  "version": "0.1.0",
  "description": "Send selected browser text to the Life Site Signal review queue.",
  "permissions": ["contextMenus", "activeTab", "storage"],
  "host_permissions": ["http://localhost:3000/*", "https://localhost:3000/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Send to Signal", "default_popup": "popup.html" }
}
